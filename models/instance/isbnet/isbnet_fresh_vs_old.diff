+# Sourced by the ISBNet tamia SLURM scripts. Paths for the fresh protocol-v1.1 setup.
+ROOT=/project/6118401/abdiaziz/fresh/isbnet
+CODE=$ROOT/ISBNet
+SIF=$ROOT/containers/killarney_pointcept.sif   # md5-verified copy of Killarney's; ISBNet ops were compiled against it
+TRAIN_NPY=$ROOT/data/hfx3d_isbnet               # converter output (train split, .npy)
+H5_ROOT=/project/6118401/abdiaziz/fresh/data/HFX3D_Instance   # released HFX3D_Instance .h5 (GT + eval input)
+RUN="bash $CODE/slurm/run_in_container.sh"      # usage: $RUN python3 tools/train.py ...
+
+stage_train_data () {   # copy the train .npy set to node-local disk
