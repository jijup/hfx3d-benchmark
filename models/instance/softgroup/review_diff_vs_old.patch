+# SoftGroup on HFX3D -- protocol v1.1 (docs/BENCHMARK_PROTOCOL.md §1.2, §3.4)
+# STAGE 2 / 2: full model (backbone + top-down refinement), initialised from the
+# stage-1 checkpoint at global step 5400, backbone NOT frozen (official
+# from-scratch STPLS3D recipe: softgroup_stpls3d.yaml has fixed_modules: []).
+# Budget: 18,000 optimizer steps total at batch 4 = 5,400 (stage 1) + 12,600 (stage 2).
+seed: 42
+model:
+  in_channels: 4          # rgb(3) + intensity(1); with_coords appends xyz(3) -> 7-D input (§1.2)
+  channels: 32            # SoftGroup default / ScanNet / S3DIS width (old run: 16, STPLS3D)
+  num_blocks: 7
+  semantic_classes: 12
+  instance_classes: 8
+  sem2ins_classes: []
+  semantic_only: False
