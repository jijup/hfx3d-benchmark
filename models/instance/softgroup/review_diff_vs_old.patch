+#!/bin/bash
+#SBATCH --job-name=sg_fresh_eval
+#SBATCH --account=aip-jijup
+#SBATCH --time=06:00:00
+#SBATCH --nodes=1
+#SBATCH --gpus=h100:4
+#SBATCH --cpus-per-task=48
+#SBATCH --mem=480G
+#SBATCH --output=/project/6118401/abdiaziz/fresh/softgroup/logs/%x-%j.out
+# Full-scene §3.2/§3.3 evaluation of ONE SoftGroup checkpoint on a split.
+# Protocol: run TEST once, with the checkpoint that has the best val AP.
+# HOW TO RUN:
+#   cd /project/6118401/abdiaziz/fresh/softgroup/SoftGroup
+#   STEP=12600 SPLIT=test sbatch --export=ALL slurm/eval_tamia.sh
+ROOT=/project/6118401/abdiaziz/fresh/softgroup
+REPO=$ROOT/SoftGroup
+SIF=/home/a/abdiaziz/pointcept.sif
+WD=$ROOT/work_dirs/hfx3d_fresh_s42
+: ${STEP:?set STEP (global step of the checkpoint)} ${SPLIT:=test}
+S=$(printf %05d $STEP)
+CFG=configs/softgroup/softgroup_hfx3d_fresh_full.yaml; [ $STEP -le 5400 ] && CFG=configs/softgroup/softgroup_hfx3d_fresh_backbone.yaml
+module load apptainer
+apptainer exec --nv --cleanenv \
+  --bind /project/6118401/abdiaziz:/project/6118401/abdiaziz \
+  --bind /home/a/abdiaziz:/home/a/abdiaziz \
+  $SIF bash -lc "cd $REPO && export PYTHONNOUSERSITE=1 PYTHONPATH=$REPO/.pydeps:$REPO OMP_NUM_THREADS=1 CUDA_VISIBLE_DEVICES=0 && \
+  python -c \"from softgroup.data.hfx3d import ensure_cache as e; e('$ROOT/data/HFX3D_Instance','$SPLIT','$ROOT/data/npy_cache')\" && \
+  python tools/test_fullscene_softgroup_hfx3d.py --config $CFG --ckpt $WD/step_$S.pth --split $SPLIT --out_dir $WD/eval_${SPLIT}/step_$S"
